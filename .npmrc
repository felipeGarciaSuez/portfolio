# El daemon de Docker Desktop en esta máquina baja paquetes grandes (el
# binario nativo de @next/swc para Linux) a 4-48 KiB/s. Con el timeout por
# defecto de pnpm, esas descargas se cortan antes de terminar. Se sube el
# timeout y los reintentos para que una descarga lenta pero viva no se
# trate como una descarga muerta.
fetch-timeout=300000
fetch-retries=5
fetch-retry-maxtimeout=60000
